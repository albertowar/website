---
interface Props {
  href: string;
  external?: boolean;
}
const { href, external = true } = Astro.props;
---

<a class="btn" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <slot />
</a>

<style>
  .btn {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 150ms ease;
  }
  .btn:hover {
    background: var(--accent-fill);
  }
</style>
