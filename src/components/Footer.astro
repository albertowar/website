---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="num">© {year} {site.name}</p>
    <ul>
      {site.socials.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target={s.url.startsWith('mailto:') ? undefined : '_blank'}>{s.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: 6rem;
    padding: 1.5rem 0 3rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
