---
import { storyIntro, type Stage } from '../data/story';
import StoryMap from './StoryMap.astro';

interface Props {
  stages: readonly Stage[];
}
const { stages } = Astro.props;
---

<p class="story__intro">{storyIntro}</p>
<StoryMap stages={stages} />

<style>
  .story__intro {
    max-width: var(--measure);
    margin: 0 0 1.75rem;
    font-size: 1.2rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
