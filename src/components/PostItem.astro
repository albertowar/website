---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, url, date, publication, series, summary } = post.data;
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<li class="post">
  <div class="post__meta">
    <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
    <span>{series ?? publication}</span>
  </div>
  <div class="post__body">
    <h3><a href={url} target="_blank" rel="noopener">{title} <span aria-hidden="true">↗</span></a></h3>
    <p>{summary}</p>
  </div>
</li>

<style>
  .post {
    display: grid;
    gap: 0.5rem 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .post {
      grid-template-columns: 11rem 1fr;
    }
  }
  .post__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .post__meta span {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--accent);
  }
  h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    margin-bottom: 0.6rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  h3 span {
    font-size: 0.7em;
    color: var(--accent);
  }
  p {
    margin: 0;
    color: var(--ink-muted);
    max-width: var(--measure);
    text-wrap: pretty;
  }
</style>
