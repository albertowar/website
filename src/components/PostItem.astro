---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, url, date, publication, series, summary } = post.data;
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<li class="row post">
  <p class="post__date label num">
    <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
  </p>
  <div class="post__main">
    <h3><a href={url} target="_blank" rel="noopener">{title}</a></h3>
    <p class="muted">{summary}</p>
  </div>
  <p class="post__where muted">
    {publication}
    {series && <span class="post__series">{series}</span>}
  </p>
</li>

<style>
  .post {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding: 1.4rem 0;
  }
  @media (min-width: 720px) {
    .post {
      grid-template-columns: 7rem minmax(0, 1fr) 12rem;
    }
  }
  .post__date {
    padding-top: 0.25rem;
    white-space: nowrap;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .post__main p {
    margin: 0.4rem 0 0;
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .post__where {
    margin: 0;
    font-size: 0.9rem;
    padding-top: 0.3rem;
  }
  .post__series {
    display: block;
  }
</style>
