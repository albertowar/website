---
import { Image } from 'astro:assets';
import { site } from '../data/site';

// Drop a photo at src/assets/hero.jpg (or .png/.webp) and it fills the right column above the facts.
const heroImages = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.{jpg,jpeg,png,webp}', {
  eager: true,
});
const hero = Object.values(heroImages)[0]?.default;
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="label">{site.role}</p>
      <h1>{site.headline}</h1>
      <p class="hero__summary">{site.summary}</p>
      <p class="hero__summary muted">{site.summary2}</p>
      <p class="hero__links">
        <a href="#story">Read the story ↓</a>
        <a href="#talks">Talks</a>
      </p>
    </div>
    <div class="hero__side">
      {hero && (
        <Image class="hero__photo" src={hero} alt="" widths={[480, 800]} sizes="(min-width: 960px) 28vw, 100vw" loading="eager" />
      )}
      <dl class="facts">
        {site.facts.map((f) => (
          <div class="facts__row">
            <dt class="label">{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
        <div class="facts__row">
          <dt class="label">Links</dt>
          <dd class="facts__links">
            {site.socials.map((s) => (
              <a href={s.url} target={s.url.startsWith('mailto:') ? undefined : '_blank'} rel="me noopener">{s.label}</a>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(calc(100svh - var(--bar)), 52rem);
    display: flex;
    align-items: center;
    padding: 3rem 0;
  }
  .hero__grid {
    display: grid;
    gap: 3rem 2rem;
    align-items: end;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .hero__text {
      grid-column: 3 / 9;
    }
    .hero__side {
      grid-column: 10 / 13;
    }
  }
  h1 {
    margin: 1rem 0 1.5rem;
    max-width: 18ch;
  }
  .hero__summary {
    max-width: 52ch;
    text-wrap: pretty;
  }
  .hero__summary.muted {
    font-size: 1rem;
  }
  .hero__links {
    display: flex;
    gap: 1.75rem;
    margin: 1.5rem 0 0;
  }
  .hero__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 2rem;
  }
  .facts {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .facts__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  dt {
    padding-top: 0.2rem;
  }
  dd {
    margin: 0;
    font-size: 0.95rem;
  }
  .facts__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
</style>
