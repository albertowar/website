---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talk: CollectionEntry<'talks'>;
}
const { talk } = Astro.props;
const { title, event, venue, year, summary } = talk.data;
const href = `/talks/${talk.id}/`;
---

<article class="card">
  <p class="card__meta">
    <span class="card__year">{year}</span>
    <span>{event}{venue ? ` · ${venue}` : ''}</span>
  </p>
  <h3><a href={href}>{title}</a></h3>
  <p class="card__summary">{summary}</p>
  <a class="card__more" href={href}>Abstract and follow-up links <span aria-hidden="true">→</span></a>
</article>

<style>
  .card {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 8px;
    position: relative;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .card__year {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }
  h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__summary {
    margin: 0;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .card__more {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
</style>
