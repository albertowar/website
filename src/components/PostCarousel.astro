---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<div class="carousel" data-carousel>
  <ol class="carousel__track" tabindex="0" aria-label="Posts" data-track>
    {posts.map(({ data: { title, url, date, series, summary, cover } }) => (
      <li class="post">
        {cover ? (
          <Image class="post__cover" src={cover} alt="" quality={60} widths={[320, 480, 800]} sizes="(min-width: 1024px) 240px, (min-width: 720px) 45vw, 80vw" />
        ) : (
          <div class="post__cover post__cover--blank" aria-hidden="true" />
        )}
        <div class="post__body">
          <p class="label num">
            <time datetime={date.toISOString().slice(0, 10)}>{dateLabel(date)}</time>
            {series && <span> · {series}</span>}
          </p>
          <h3><a href={url} target="_blank" rel="noopener">{title}</a></h3>
          <p class="muted">{summary}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="carousel__nav">
    <button type="button" class="carousel__btn" data-prev aria-label="Previous post">←</button>
    <button type="button" class="carousel__btn" data-next aria-label="Next post">→</button>
  </div>
</div>

<script>
  import { initCarousel } from '../scripts/carousel';

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]:not([data-shown])')) {
    initCarousel(root);
  }
</script>

<style>
  @media (min-width: 720px) {
    .post {
      flex-basis: calc((100% - 12px) / 2);
    }
  }
  @media (min-width: 1024px) {
    .post {
      flex-basis: calc((100% - 24px) / 3);
    }
  }
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid var(--line);
    transition: border-color 150ms ease;
  }
  .post:hover,
  .post:focus-within {
    border-color: var(--accent);
  }
  .post__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .post__cover--blank {
    background: var(--accent-fill);
  }
  .post__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.25rem 1.25rem;
  }
  h3 {
    margin: 0.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.3;
    text-wrap: balance;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .post__body > p {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    text-wrap: pretty;
  }
</style>
