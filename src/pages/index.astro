---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Story from '../components/Story.astro';
import WorkCard from '../components/WorkCard.astro';
import BookCall from '../components/BookCall.astro';
import TalkRow from '../components/TalkRow.astro';
import PostCarousel from '../components/PostCarousel.astro';
import ArcadeGate from '../components/ArcadeGate.astro';
import BonusStage from '../components/BonusStage.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { stages } from '../data/story';
import { work } from '../data/work';
import { consulting } from '../data/consulting';
import { personNode, personId } from '../lib/schema';

const talks = (await getCollection('talks')).sort(
  (a, b) => b.data.year - a.data.year || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const writing = await getEntry('pages', 'writing');
if (!writing) throw new Error('Missing src/content/pages/writing.md');
const { Content: WritingContent } = await render(writing);

const count = (n: number) => String(n).padStart(2, '0');

const origin = Astro.site ?? new URL(`https://${site.domain}`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': new URL('/#profile', origin).href,
      url: origin.href,
      name: `${site.name} · ${site.jobTitle}`,
      description: site.metaDescription,
      mainEntity: { '@id': personId(origin) },
    },
    personNode(origin, new URL('/og/home.png', origin).href),
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', origin).href,
      url: origin.href,
      name: site.name,
      inLanguage: 'en',
      author: { '@id': personId(origin) },
    },
  ],
};
---

<Base path="/" gate>
  <JsonLd slot="head" data={jsonLd} />
  <ArcadeGate>
    <Hero />

    <Section id="work" label="Work" icon="work" count={count(work.length)}>
      <ul class="cards">
        {work.map((item) => <WorkCard item={item} />)}
      </ul>
    </Section>

    <Section id="consulting" label="Consulting" icon="consulting">
      <p class="consulting__intro">{consulting.intro}</p>
      <ul class="cards cards--two">
        {consulting.offers.map((item) => <WorkCard item={item} />)}
      </ul>
      <BookCall />
    </Section>

    <Section
      id="talks"
      label="Talks"
      icon="talks"
      count={count(talks.length)}
    >
      <ol class="rows">
        {talks.map((talk) => <TalkRow talk={talk} />)}
      </ol>
    </Section>

    <Section
      id="posts"
      label="Posts"
      icon="posts"
      count={count(posts.length)}
    >
      <PostCarousel posts={posts} />
    </Section>

    <Section id="writing" label="Writing" icon="writing">
      <div class="prose writing">
        <WritingContent />
      </div>
      {writing.data.status && (
        <p class="status label"><span aria-hidden="true">▪</span> {writing.data.status}</p>
      )}
    </Section>

    <Section id="story" label="Story" icon="story" count={count(stages.length)}>
      <Story stages={stages} />
    </Section>

    <Section id="photography" label="Photography" icon="photography">
      <BonusStage />
    </Section>
  </ArcadeGate>
</Base>

<style>
  .cards {
    display: grid;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cards--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .consulting__intro {
    max-width: var(--measure);
    margin: 0 0 2rem;
    font-size: 1.1rem;
    text-wrap: pretty;
  }
  .writing {
    font-size: 1.1rem;
  }
  .status {
    margin-top: 1.25rem;
  }
  .status span {
    color: var(--signal);
    font-size: 0.6em;
    vertical-align: 0.15em;
    margin-right: 0.35rem;
  }
</style>
