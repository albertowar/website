---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Story from '../components/Story.astro';
import TalkRow from '../components/TalkRow.astro';
import PostItem from '../components/PostItem.astro';
import ArcadeGate from '../components/ArcadeGate.astro';
import BonusStage from '../components/BonusStage.astro';
import { site } from '../data/site';
import { stages } from '../data/story';

const talks = (await getCollection('talks')).sort(
  (a, b) => b.data.year - a.data.year || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const writing = await getEntry('pages', 'writing');
if (!writing) throw new Error('Missing src/content/pages/writing.md');
const { Content: WritingContent } = await render(writing);

const count = (n: number) => String(n).padStart(2, '0');
---

<Base path="/" gate>
  <Hero />

  <ArcadeGate>
    <Section id="story" label="Story" count={count(stages.length)}>
      <Story stages={stages} />
    </Section>

    <Section
      id="talks"
      label="Talks"
      count={count(talks.length)}
      kicker="Conference and university talks. Each one has its own page with the abstract and follow-up links."
    >
      <ol class="rows">
        {talks.map((talk) => <TalkRow talk={talk} />)}
      </ol>
      <p class="aside muted">
        Abstracts and links also live on <a href={site.talksRepo} target="_blank" rel="noopener">GitHub</a>.
      </p>
    </Section>

    <Section
      id="posts"
      label="Posts"
      count={count(posts.length)}
      kicker="Articles on AI, software engineering and security, published on LinkedIn."
    >
      <ol class="rows">
        {posts.map((post) => <PostItem post={post} />)}
      </ol>
    </Section>

    <Section id="writing" label="Writing">
      <div class="prose writing">
        <WritingContent />
      </div>
      {writing.data.status && (
        <p class="status label"><span aria-hidden="true">▪</span> {writing.data.status}</p>
      )}
    </Section>

    <Section id="photography" label="Photography">
      <BonusStage />
    </Section>
  </ArcadeGate>
</Base>

<style>
  .aside {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  .writing {
    font-size: 1.1rem;
  }
  .status {
    margin-top: 1.25rem;
  }
  .status span {
    color: var(--signal);
    font-size: 0.6em;
    vertical-align: 0.15em;
    margin-right: 0.35rem;
  }
</style>
