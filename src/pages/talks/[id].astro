---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LinkButton from '../../components/LinkButton.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site } from '../../data/site';
import { personRef } from '../../lib/schema';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}

interface Props {
  talk: CollectionEntry<'talks'>;
}
const { talk } = Astro.props;
const { title, event, venue, year, date, summary, slides, video, sourceUrl } = talk.data;
const { Content } = await render(talk);
const dateLabel = date?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const hasLinks = slides || video || sourceUrl;

const origin = Astro.site ?? new URL(`https://${site.domain}`);
const path = `/talks/${talk.id}/`;
const image = `/og/talks/${talk.id}.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': new URL(path, origin).href,
  mainEntityOfPage: new URL(path, origin).href,
  headline: title,
  description: summary,
  image: new URL(image, origin).href,
  inLanguage: 'en',
  author: personRef(origin),
  about: `Talk given at ${[event, venue].filter(Boolean).join(', ')}, ${year}.`,
  ...(date && { datePublished: date.toISOString().slice(0, 10) }),
  ...(sourceUrl && { isBasedOn: sourceUrl }),
  ...(video && { video }),
};
---

<Base
  title={title}
  description={summary}
  path={path}
  type="article"
  image={image}
  imageAlt={`${title}, a talk by ${site.name}`}
  publishedTime={date}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="wrap talk">
    <aside class="talk__side">
      <p class="talk__back"><a href="/#talks">← All talks</a></p>
      <dl class="meta">
        <div class="meta__row">
          <dt class="label">Event</dt>
          <dd>{event}</dd>
        </div>
        {venue && (
          <div class="meta__row">
            <dt class="label">Venue</dt>
            <dd>{venue}</dd>
          </div>
        )}
        <div class="meta__row">
          <dt class="label">When</dt>
          <dd class="num">{dateLabel ?? year}</dd>
        </div>
        {hasLinks && (
          <div class="meta__row">
            <dt class="label">Links</dt>
            <dd class="meta__links">
              {slides && <LinkButton href={slides}>Slides</LinkButton>}
              {video && <LinkButton href={video}>Video</LinkButton>}
              {sourceUrl && <LinkButton href={sourceUrl}>Source on GitHub</LinkButton>}
            </dd>
          </div>
        )}
      </dl>
    </aside>
    <div class="talk__main">
      <h1>{title}</h1>
      <div class="prose talk__body">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .talk {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-top: 3rem;
  }
  @media (min-width: 960px) {
    .talk {
      grid-template-columns: 3fr 8fr 1fr;
      padding-top: 5rem;
    }
    .talk__side {
      position: sticky;
      top: calc(var(--bar) + 2rem);
    }
  }
  .talk__back {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
  }
  .talk__back a {
    text-decoration: none;
  }
  .meta {
    margin: 0;
    border-bottom: 1px solid var(--line);
    max-width: 22rem;
  }
  .meta__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  dt {
    padding-top: 0.2rem;
  }
  dd {
    margin: 0;
    font-size: 0.95rem;
  }
  .meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  h1 {
    max-width: 20ch;
    margin-bottom: 2.5rem;
  }
  .talk__body {
    font-size: 1.1rem;
  }
</style>
