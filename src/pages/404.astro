---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" path="/404/">
  <div class="wrap nf">
    <p class="nf__code label num">404</p>
    <h1>That page is not here.</h1>
    <p><a href="/">Back to the front page</a></p>
  </div>
</Base>

<style>
  .nf {
    padding: 8rem 0;
  }
  .nf__code {
    margin-bottom: 1rem;
  }
  h1 {
    margin-bottom: 1.5rem;
  }
</style>
